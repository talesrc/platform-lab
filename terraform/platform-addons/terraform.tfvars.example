# cluster_state_path = "../kind-cluster/terraform.tfstate"

argocd = {
  # renovate: datasource=helm depName=argo-cd registryUrl=https://argoproj.github.io/argo-helm
  chart_version = "10.10.2"
  # renovate: datasource=helm depName=argocd-apps registryUrl=https://argoproj.github.io/argo-helm
  apps_chart_version = "2.0.6"
  hostname           = "argocd.lab.localhost"
}

# GitHub login (optional). Create an OAuth App: GitHub > Settings > Developer settings >
# OAuth Apps, with Homepage URL https://argocd.lab.localhost and Authorization callback URL
# https://argocd.lab.localhost/api/dex/callback. Real values go only in terraform.tfvars.
# github_oauth = {
#   client_id     = "<client id>"
#   client_secret = "<client secret>"
# }
# argocd_admins         = ["you@example.com"] # GitHub email or username
# argocd_app_developers = []

gitops = {
  repo_url        = "https://github.com/talesrc/platform-lab.git"
  target_revision = "main"
  path            = "gitops/platform"
}
