{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "platform-lab app chart values",
  "type": "object",
  "required": ["image", "port"],
  "properties": {
    "nameOverride": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$" },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "latest" },
          "description": "A pinned version; `latest` is rejected by the platform policies too."
        },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "command": { "type": "array", "items": { "type": "string" } },
    "args": { "type": "array", "items": { "type": "string" } },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "secretEnv": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/envName" },
      "description": "Env vars from Vault (secret/<secrets.vaultPath>/<name>, field value), by secretKeyRef."
    },
    "generatedSecretEnv": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/envName" },
      "additionalProperties": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": {
          "length": { "type": "integer", "minimum": 16, "maximum": 128 },
          "digits": { "type": "integer", "minimum": 0 },
          "symbols": { "type": "integer", "minimum": 0 },
          "symbolCharacters": { "type": "string", "minLength": 1 },
          "noUpper": { "type": "boolean" },
          "allowRepeat": { "type": "boolean" }
        }
      },
      "description": "Env vars with random values from an External Secrets Password generator, made once."
    },
    "secrets": {
      "type": "object",
      "properties": {
        "vaultPath": {
          "type": "string",
          "pattern": "^(apps/[a-z0-9]([-a-z0-9]*[a-z0-9])?/[a-z]+)?$",
          "description": "apps/<name>/<env>; set by the apps ApplicationSet."
        },
        "store": { "type": "string", "minLength": 1 },
        "refreshInterval": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" }
      }
    },
    "replicas": { "type": "integer", "minimum": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "service": {
      "type": "object",
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    },
    "probes": {
      "type": "object",
      "properties": {
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["memory"] }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 }
      }
    },
    "writablePaths": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
    "route": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "hostname": { "type": "string" } }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "interval": { "type": "string" }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "metric": { "type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$" },
        "selector": { "type": "string" },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "objective": { "$ref": "#/definitions/objective" },
            "errorSelector": { "type": "string", "minLength": 1 }
          }
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "objective": { "$ref": "#/definitions/objective" },
            "le": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$",
              "description": "A bucket boundary of the histogram, as Prometheus stores it (e.g. 0.5, 1.0)."
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "minAvailable": { "type": "integer", "minimum": 1 } }
    }
  },
  "definitions": {
    "envName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "objective": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 100,
      "description": "Percent of requests over 30 days, e.g. 99.5."
    },
    "probe": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "periodSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
